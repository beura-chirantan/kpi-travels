# Default: a persistent local SQLite file. PostgreSQL is supported by the same API.
DATABASE_URL=sqlite:///./data/ticketing.db
# For PostgreSQL, run docker compose up -d and use:
# DATABASE_URL=postgresql+psycopg://kpi:kpi_local_only@127.0.0.1:5432/kpi
SEED_DEMO=true
COOKIE_SECURE=false
# Set false for non-local deployments; never publish the demo passwords.
DEMO_PASSWORD=TravelDemo123!
# Temporary checkout hold. The API accepts 60–900 seconds; 600 is 10 minutes.
SEAT_HOLD_SECONDS=600
# Private observability portal at /developer. Set separate credentials before delivery.
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=
# Groq is the preferred low-latency AI provider. Keep real keys only in .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional fallback provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: public API URL for a separately hosted React frontend.
VITE_API_BASE_URL=
# Server-side API relay for a production React server. Use HTTPS when hosted.
API_ORIGIN=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
